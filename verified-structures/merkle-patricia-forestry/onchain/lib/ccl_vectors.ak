// single: present key "only"
const proof_51 =
  [
  ]

test present_51() {
  let key = #"6f6e6c79"
  let value = #"6f6e65"
  let trie = mpf.from_root(#"7c283507f3d99da945dd421a8c24fde6327e773efe1e4841366b23e82dca68ff")
  let without = null_root
  and {
    mpf.has(trie, key, value, proof_51),
    mpf.root(mpf.delete(trie, key, value, proof_51)) == without,
    mpf.root(mpf.insert(mpf.from_root(without), key, value, proof_51)) == #"7c283507f3d99da945dd421a8c24fde6327e773efe1e4841366b23e82dca68ff",
    mpf.root(mpf.update(trie, key, proof_51, value, #"63636c2d75706461746564")) == #"bc43f56ffde60e4d98f4a460835e77b322f88a22a8e33754af1b2a94481604d6",
  }
}

