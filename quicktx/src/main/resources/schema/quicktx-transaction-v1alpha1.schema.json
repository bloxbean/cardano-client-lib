{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardano-client.dev/schemas/quicktx/transaction/v1alpha1",
  "title": "QuickTx embedded transaction v1alpha1",
  "description": "QuickTx/TxPlan transaction contract. The root describes a standalone TxPlan YAML document; $defs/transaction is the single transaction embedded by a TxFlow step. Intent definitions ($defs/intent.*, $defs/model.*) are generated from the Jackson model by TxPlanSchemaGenerator: run ./gradlew :quicktx:generateTxPlanSchema after changing an intent.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "variables": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "transaction": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tx": {
            "$ref": "#/$defs/tx"
          }
        }
      }
    }
  },
  "$defs": {
    "flowOutputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flow_output"
      ],
      "properties": {
        "flow_output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "step",
            "output"
          ],
          "properties": {
            "step": {
              "type": "string",
              "minLength": 1
            },
            "output": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "utxoRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tx_hash",
        "output_index"
      ],
      "properties": {
        "tx_hash": {
          "type": "string"
        },
        "output_index": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "inputRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/utxoRef"
        },
        {
          "$ref": "#/$defs/flowOutputRef"
        }
      ]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tx"
      ],
      "properties": {
        "tx": {
          "$ref": "#/$defs/tx"
        },
        "context": {
          "$ref": "#/$defs/context"
        }
      }
    },
    "tx": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "from_ref": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "from_wallet": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "change_address": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "change_datum": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "change_datum_hash": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/intent.collect_from"
              },
              {
                "$ref": "#/$defs/intent.reference_input"
              },
              {
                "$ref": "#/$defs/intent.script_collect_from"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "$ref": "#/$defs/placeholder"
                  }
                }
              }
            ]
          }
        },
        "intents": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/intent.collect_from"
              },
              {
                "$ref": "#/$defs/intent.donation"
              },
              {
                "$ref": "#/$defs/intent.drep_deregistration"
              },
              {
                "$ref": "#/$defs/intent.drep_registration"
              },
              {
                "$ref": "#/$defs/intent.drep_update"
              },
              {
                "$ref": "#/$defs/intent.governance_proposal"
              },
              {
                "$ref": "#/$defs/intent.metadata"
              },
              {
                "$ref": "#/$defs/intent.minting"
              },
              {
                "$ref": "#/$defs/intent.native_script"
              },
              {
                "$ref": "#/$defs/intent.payment"
              },
              {
                "$ref": "#/$defs/intent.pool_registration"
              },
              {
                "$ref": "#/$defs/intent.pool_retirement"
              },
              {
                "$ref": "#/$defs/intent.pool_update"
              },
              {
                "$ref": "#/$defs/intent.reference_input"
              },
              {
                "$ref": "#/$defs/intent.script_collect_from"
              },
              {
                "$ref": "#/$defs/intent.script_minting"
              },
              {
                "$ref": "#/$defs/intent.stake_delegation"
              },
              {
                "$ref": "#/$defs/intent.stake_deregistration"
              },
              {
                "$ref": "#/$defs/intent.stake_registration"
              },
              {
                "$ref": "#/$defs/intent.stake_withdrawal"
              },
              {
                "$ref": "#/$defs/intent.validator"
              },
              {
                "$ref": "#/$defs/intent.voting"
              },
              {
                "$ref": "#/$defs/intent.voting_delegation"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "pattern": "^[^:]+:.+$"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "$ref": "#/$defs/placeholder"
                  }
                }
              }
            ]
          }
        },
        "scripts": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/intent.native_script"
              },
              {
                "$ref": "#/$defs/intent.validator"
              },
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "$ref": "#/$defs/placeholder"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fee_payer": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "fee_payer_ref": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "collateral_payer": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "collateral_payer_ref": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "required_signers": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "valid_from_slot": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "#/$defs/integerLike"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "valid_to_slot": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "$ref": "#/$defs/integerLike"
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "signers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "scope": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        "additional_signers_count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            {
              "$ref": "#/$defs/placeholder"
            }
          ]
        },
        "deposit_payer": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "deposit_mode": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      }
    },
    "booleanLike": {
      "type": "string",
      "pattern": "^\\s*(true|True|TRUE|false|False|FALSE)\\s*$",
      "description": "A boolean written as a string, e.g. a quoted '${flag}' substituted as text"
    },
    "integerLike": {
      "type": "string",
      "pattern": "^\\s*[+-]?[0-9]+\\s*$",
      "description": "An integer written as a string"
    },
