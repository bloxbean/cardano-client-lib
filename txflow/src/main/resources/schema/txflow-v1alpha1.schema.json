{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardano-client.dev/schemas/txflow/v1alpha1",
  "title": "Portable TxFlow v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "metadata", "spec"],
  "properties": {
    "api_version": { "const": "txflow.cardano-client.dev/v1alpha1" },
    "kind": { "const": "TxFlow" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "network": { "type": "string" },
        "parameters": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/parameter" }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["SEQUENTIAL", "PIPELINED", "BATCH"] },
            "confirmation": { "$ref": "#/$defs/confirmation" },
            "rollback": { "$ref": "#/$defs/rollback" },
            "retry": { "$ref": "#/$defs/retry" },
            "validity": { "$ref": "#/$defs/validity" }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^([0-9]+(ms|s|m|h)|P.*)$"
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "enum": ["defaults", "devnet", "testnet", "quick"] },
        "min_confirmations": { "type": "integer", "minimum": 0 },
        "check_interval": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "enum": ["FAIL", "WAIT_FOR_REINCLUSION", "RECONCILE_AND_REBUILD", "PAUSE_FOR_RECOVERY"] },
        "monitoring_horizon": { "enum": ["UNTIL_STEP_CONFIRMED", "UNTIL_FLOW_TERMINAL"] },
        "rebuild_scope": { "enum": ["AFFECTED_STEP", "INVALIDATED_CLOSURE"] },
        "max_recovery_cycles": { "type": "integer", "minimum": 0, "maximum": 100 },
        "reinclusion_window": { "$ref": "#/$defs/duration" },
        "minimum_consistent_absence_observations": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "backoff": { "enum": ["fixed", "linear", "exponential", "FIXED", "LINEAR", "EXPONENTIAL"] },
        "initial_delay": { "$ref": "#/$defs/duration" },
        "max_delay": { "$ref": "#/$defs/duration" },
        "jitter": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window"],
      "properties": {
        "window": { "$ref": "#/$defs/duration" },
        "resubmit_safety_margin": { "type": "integer", "minimum": 0 }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string", "integer", "boolean", "address", "asset_unit"] },
        "required": { "type": "boolean" },
        "default": {},
        "minimum": { "type": "integer" },
        "maximum": { "type": "integer" },
        "max_length": { "type": "integer", "minimum": 0 },
        "sensitive": { "type": "boolean" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transaction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "needs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "outputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["select", "expect"],
            "properties": {
              "select": {
                "type": "object",
                "additionalProperties": false,
                "required": ["output_index"],
                "properties": { "output_index": { "type": "integer", "minimum": 0 } }
              },
              "expect": { "enum": ["exactly_one"] }
            }
          }
        },
        "transaction": {
          "$ref": "https://cardano-client.dev/schemas/quicktx/transaction/v1alpha1#/$defs/transaction"
        }
      }
    }
  }
}
